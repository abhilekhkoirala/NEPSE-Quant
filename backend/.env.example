# Server-side secrets only. Never prefix anything in this file with VITE_
# (or any bundler's public-env prefix) — that's what causes a variable to
# get baked into the frontend's shipped JS bundle.
#
# Copy this file to .env and fill in real values. .env is gitignored.
GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated list of frontend origins allowed to call this API.
FRONTEND_ORIGIN=http://localhost:5173

PORT=3001
